# ---------------------------------------------------------------------------
# GitHub access
# ---------------------------------------------------------------------------
# A classic or fine-grained token with PUBLIC read access only. No scopes are
# required beyond public data — the project analyses public repositories only,
# which is a stated ethical constraint, not just a technical one.
#
# Without a token you get 60 requests/hour. One candidate costs roughly 60–100
# calls, so unauthenticated use is a demo, not a workflow.
# With a token: 5,000/hour.
#
# If this is unset, the engine falls back to `gh auth token` when the GitHub
# CLI is logged in.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Service (service/app.py)
# ---------------------------------------------------------------------------
# Shared secret the Node backend sends as X-Api-Key. Leave blank in local dev
# and the service accepts unauthenticated calls (same behaviour as cv_parser).
# NEVER leave blank in a deployed environment: /score accepts an arbitrary PDF
# and spends your GitHub rate limit.
ENGINE_API_KEY=

PORT=5002
ENGINE_CACHE_DIR=.cache/github
MAX_UPLOAD_MB=10
