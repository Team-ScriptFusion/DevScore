[Unit]
Description=DevScore cv_parser microservice
After=network.target

[Service]
Type=simple
User=devscore
WorkingDirectory=/opt/devscore/cv_parser
EnvironmentFile=/opt/devscore/cv_parser/.env
Environment=PORT=5001
ExecStart=/opt/devscore/cv_parser/venv/bin/gunicorn app:app --bind 0.0.0.0:5001 --workers 2 --timeout 90
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
