[Unit]
Description=DevScore scoring microservice
After=network.target

[Service]
Type=simple
User=devscore
WorkingDirectory=/opt/devscore/services/scoring
EnvironmentFile=/opt/devscore/services/scoring/.env
Environment=PORT=5004
ExecStart=/opt/devscore/services/scoring/venv/bin/gunicorn app:app --bind 0.0.0.0:5004 --workers 2 --timeout 90
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
