[Unit]
Description=DevScore Node API server
After=network.target

[Service]
Type=simple
User=devscore
WorkingDirectory=/opt/devscore/server
EnvironmentFile=/opt/devscore/server/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
