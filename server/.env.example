# DevScore server configuration
PORT=5000
NODE_ENV=development

# Data Tier — Supabase (Postgres)
# Project URL and the SERVICE ROLE key (server-side only, never expose to the client).
# Find these in Supabase dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side session tokens (FR 7 / FR 17) — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth (FR 1–5). Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth — used both for "Sign in / up with GitHub" and for a Student
# connecting their GitHub account for evidence mining (FR 9–10). Both flows
# share this one app and callback URL (distinguished server-side by a signed
# state param), so only a single Authorization callback URL needs to be
# registered on GitHub. Obtain credentials from
# https://github.com/settings/developers (OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Email/password accounts reuse JWT_SECRET above for session signing —
# no extra config needed.

# Where the client app lives (used for post-login redirect)
CLIENT_URL=http://localhost:5173

# CV parser microservice (FR 28-32 — resume skill extraction). See cv_parser/.
CV_PARSER_URL=http://localhost:5001
CV_PARSER_API_KEY=
